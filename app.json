{
  "expo": {
    "name": "languages-giraffe",
    "slug": "languages-giraffe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "languagesgiraffe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.languagesgiraffe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#47269D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.languagesgiraffe"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#47269D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Graphik Arabic",
                "fontDefinitions": [
                  {
                    "path": "./assets/font/GraphikArabic-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Extralight.ttf",
                    "weight": 200
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Semibold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/font/GraphikArabic-Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "GraphikArabic-Super",
                "fontDefinitions": [
                  {
                    "path": "./assets/font/GraphikArabic-Super.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Pusab",
                "fontDefinitions": [
                  {
                    "path": "./assets/font/PUSAB.otf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/font/GraphikArabic-Thin.ttf",
              "./assets/font/GraphikArabic-Extralight.ttf",
              "./assets/font/GraphikArabic-Light.ttf",
              "./assets/font/GraphikArabic-Regular.ttf",
              "./assets/font/GraphikArabic-Medium.ttf",
              "./assets/font/GraphikArabic-Semibold.ttf",
              "./assets/font/GraphikArabic-Bold.ttf",
              "./assets/font/GraphikArabic-Black.ttf",
              "./assets/font/GraphikArabic-Super.ttf",
              "./assets/font/PUSAB.otf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
